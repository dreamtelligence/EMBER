OPENAI_API_KEY=
# Set to any provider-supported OpenAI model id when you want to switch.
OPENAI_BOOK_MODEL=gpt-6.1-sol

ANTHROPIC_API_KEY=
# Set to any provider-supported Anthropic model id, e.g. claude-sonnet-5-5, claude-opus-5-5 or claude-fable-5-1.
ANTHROPIC_BOOK_MODEL=claude-opus-5-5
ANTHROPIC_CONTINUITY_MODEL=claude-opus-5-5

# Optional local Gemma/MLX assistant for cheap brainstorming in the Studio chat.
# This is intentionally not used for Book draft jobs.
LOCAL_GEMMA_SERVER_URL=http://127.0.0.1:18080
LOCAL_GEMMA_SERVER_TIMEOUT_MS=60000
LOCAL_GEMMA_SERVER_ONLY=false
LOCAL_GEMMA_COMMAND=/path/to/your/.venv/bin/mlx_vlm.generate
LOCAL_GEMMA_MODEL=mlx-community/gemma-4-e4b-it-mxfp4
LOCAL_GEMMA_MAX_TOKENS=1200
LOCAL_GEMMA_TEMPERATURE=0.35
LOCAL_GEMMA_TIMEOUT_MS=180000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron: protects /api/keepalive (Vercel sends it as Bearer token)
CRON_SECRET=
